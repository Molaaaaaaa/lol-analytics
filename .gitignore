# ---- 비밀 ----
# 이름 하나만 막으면 .env.bak / .env copy / .dev.vars 로 새어 나간다.
.env
.env*
!.env.example
.dev.vars
.dev.vars.*
*_local.py
config_local.py
secrets.py
credentials.json
riot_api_key.txt
*credential*
*secret*
*.pem
*.key
*.p12

# 절대 커밋 금지 — API 키·전적 원본 데이터
data/
riot_cache/
*.parquet
*.duckdb
__pycache__/
.DS_Store

# 검증용 도구 — 저장소에 넣을 것이 아니다
# (jsdom 으로 헤드리스 렌더링해서 화면을 확인한다. npm install jsdom --no-save)
node_modules/
package-lock.json
# 예전엔 `_*.js` 였는데 하위 경로까지 걸려서 Cloudflare Pages Functions 의
# 예약 파일명(functions/_middleware.js)과 공용 모듈(functions/api/_riot.js)을
# 조용히 삼켰다. 커밋한 사람은 로컬에서 잘 돌아가니 알아채기 어렵다.
# 검증용 임시 스크립트는 루트에만 만들므로 루트로 한정한다.
/_*.js
